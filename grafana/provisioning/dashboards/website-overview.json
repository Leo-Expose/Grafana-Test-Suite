{
  "dashboard": {
    "title": "Website Overview",
    "description": "Combined monitoring for Sudoku Solver + Grafana + System",
    "tags": [
      "sudoku",
      "overview"
    ],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 0,
    "panels": [
      {
        "id": 1,
        "title": "Site Status",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 3,
          "x": 0,
          "y": 0
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "probe_success{instance=~\"$site\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        }
      },
      {
        "id": 2,
        "title": "SSL Days Left",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 3,
          "x": 3,
          "y": 0
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "round((probe_ssl_earliest_cert_expiry{instance=~\"$site\"} - time()) / 86400)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "d",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 30
                },
                {
                  "color": "red",
                  "value": 7
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        }
      },
      {
        "id": 3,
        "title": "Response Time",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 3,
          "x": 6,
          "y": 0
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "probe_duration_seconds{instance=~\"$site\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 0.5
                },
                {
                  "color": "red",
                  "value": 2
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        }
      },
      {
        "id": 4,
        "title": "Nginx Active",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 3,
          "x": 9,
          "y": 0
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "nginx_connections_active{instance=\"host.docker.internal:9113\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 50
                },
                {
                  "color": "red",
                  "value": 100
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        }
      },
      {
        "id": 5,
        "title": "Nginx Request Rate",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 3,
          "x": 12,
          "y": 0
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "rate(nginx_http_requests_total{instance=\"host.docker.internal:9113\"}[5m])",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "cps"
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        }
      },
      {
        "id": 6,
        "title": "Uptime (days)",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 3,
          "x": 15,
          "y": 0
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "round(node_time_seconds{instance=\"host.docker.internal:9100\"} - node_boot_time_seconds{instance=\"host.docker.internal:9100\"}) / 86400",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "d"
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        }
      },
      {
        "id": 7,
        "title": "Total Requests",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 3,
          "x": 18,
          "y": 0
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "nginx_http_requests_total{instance=\"host.docker.internal:9113\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        }
      },
      {
        "id": 8,
        "title": "Disk Used",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 3,
          "x": 21,
          "y": 0
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "100 - ((node_filesystem_avail_bytes{mountpoint=\"/\",instance=\"host.docker.internal:9100\",fstype!=\"tmpfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",instance=\"host.docker.internal:9100\",fstype!=\"tmpfs\"}) * 100)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent"
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        }
      },
      {
        "id": 9,
        "title": "Active Connections (by state)",
        "type": "timeseries",
        "gridPos": {
          "h": 6,
          "w": 4,
          "x": 0,
          "y": 4
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "nginx_connections_reading{instance=\"host.docker.internal:9113\"}",
            "refId": "A",
            "legendFormat": "Reading"
          },
          {
            "expr": "nginx_connections_writing{instance=\"host.docker.internal:9113\"}",
            "refId": "B",
            "legendFormat": "Writing"
          },
          {
            "expr": "nginx_connections_waiting{instance=\"host.docker.internal:9113\"}",
            "refId": "C",
            "legendFormat": "Waiting"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "lineInterpolation": "smooth",
              "showPoints": "never",
              "spanNulls": true
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "calcs": [
              "mean",
              "max"
            ],
            "displayMode": "table",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        }
      },
      {
        "id": 10,
        "title": "Requests per Second",
        "type": "timeseries",
        "gridPos": {
          "h": 6,
          "w": 4,
          "x": 4,
          "y": 4
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "rate(nginx_http_requests_total{instance=\"host.docker.internal:9113\"}[1m])",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "cps"
          }
        },
        "options": {
          "legend": {
            "calcs": [
              "mean",
              "max"
            ],
            "displayMode": "table",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        }
      },
      {
        "id": 11,
        "title": "Response Time (over time)",
        "type": "timeseries",
        "gridPos": {
          "h": 6,
          "w": 4,
          "x": 8,
          "y": 4
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "probe_duration_seconds{instance=~\"$site\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        },
        "options": {
          "legend": {
            "calcs": [
              "mean",
              "max"
            ],
            "displayMode": "table",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        }
      },
      {
        "id": 12,
        "title": "CPU Usage",
        "type": "gauge",
        "gridPos": {
          "h": 6,
          "w": 4,
          "x": 0,
          "y": 10
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "100 - (avg by(instance)(rate(node_cpu_seconds_total{mode=\"idle\",instance=\"host.docker.internal:9100\"}[5m])) * 100)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 70
                },
                {
                  "color": "red",
                  "value": 90
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        }
      },
      {
        "id": 13,
        "title": "Memory Usage",
        "type": "gauge",
        "gridPos": {
          "h": 6,
          "w": 4,
          "x": 4,
          "y": 10
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "(1 - node_memory_MemAvailable_bytes{instance=\"host.docker.internal:9100\"} / node_memory_MemTotal_bytes{instance=\"host.docker.internal:9100\"}) * 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 70
                },
                {
                  "color": "red",
                  "value": 90
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        }
      },
      {
        "id": 14,
        "title": "Disk Usage",
        "type": "gauge",
        "gridPos": {
          "h": 6,
          "w": 4,
          "x": 8,
          "y": 10
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "100 - ((node_filesystem_avail_bytes{mountpoint=\"/\",instance=\"host.docker.internal:9100\",fstype!=\"tmpfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",instance=\"host.docker.internal:9100\",fstype!=\"tmpfs\"}) * 100)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 70
                },
                {
                  "color": "red",
                  "value": 90
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        }
      },
      {
        "id": 15,
        "title": "Network I/O",
        "type": "timeseries",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 12,
          "y": 10
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "rate(node_network_receive_bytes_total{device=~\"ens5|eth0\",instance=\"host.docker.internal:9100\"}[1m])",
            "refId": "A",
            "legendFormat": "In"
          },
          {
            "expr": "rate(node_network_transmit_bytes_total{device=~\"ens5|eth0\",instance=\"host.docker.internal:9100\"}[1m])",
            "refId": "B",
            "legendFormat": "Out"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "Bps"
          }
        },
        "options": {
          "legend": {
            "calcs": [
              "mean",
              "max"
            ],
            "displayMode": "table",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        }
      },
      {
        "id": 16,
        "title": "Load Average",
        "type": "timeseries",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 18,
          "y": 10
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "node_load1{instance=\"host.docker.internal:9100\"}",
            "refId": "A",
            "legendFormat": "1m"
          },
          {
            "expr": "node_load5{instance=\"host.docker.internal:9100\"}",
            "refId": "B",
            "legendFormat": "5m"
          },
          {
            "expr": "node_load15{instance=\"host.docker.internal:9100\"}",
            "refId": "C",
            "legendFormat": "15m"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "lineInterpolation": "smooth",
              "showPoints": "never",
              "spanNulls": true
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "calcs": [
              "mean",
              "max"
            ],
            "displayMode": "table",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        }
      },
      {
        "id": 17,
        "title": "System CPU (detailed)",
        "type": "timeseries",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 0,
          "y": 16
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "rate(node_cpu_seconds_total{mode=\"user\",instance=\"host.docker.internal:9100\"}[5m]) * 100",
            "refId": "A",
            "legendFormat": "User"
          },
          {
            "expr": "rate(node_cpu_seconds_total{mode=\"system\",instance=\"host.docker.internal:9100\"}[5m]) * 100",
            "refId": "B",
            "legendFormat": "System"
          },
          {
            "expr": "rate(node_cpu_seconds_total{mode=\"iowait\",instance=\"host.docker.internal:9100\"}[5m]) * 100",
            "refId": "C",
            "legendFormat": "IOWait"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent"
          }
        },
        "options": {
          "legend": {
            "calcs": [
              "mean",
              "max"
            ],
            "displayMode": "table",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        }
      },
      {
        "id": 18,
        "title": "Memory breakdown",
        "type": "timeseries",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 6,
          "y": 16
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "node_memory_MemFree_bytes{instance=\"host.docker.internal:9100\"}",
            "refId": "A",
            "legendFormat": "Free"
          },
          {
            "expr": "node_memory_Buffers_bytes{instance=\"host.docker.internal:9100\"}",
            "refId": "B",
            "legendFormat": "Buffers"
          },
          {
            "expr": "node_memory_Cached_bytes{instance=\"host.docker.internal:9100\"}",
            "refId": "C",
            "legendFormat": "Cached"
          },
          {
            "expr": "node_memory_MemTotal_bytes{instance=\"host.docker.internal:9100\"} - node_memory_MemFree_bytes{instance=\"host.docker.internal:9100\"} - node_memory_Buffers_bytes{instance=\"host.docker.internal:9100\"} - node_memory_Cached_bytes{instance=\"host.docker.internal:9100\"}",
            "refId": "D",
            "legendFormat": "Used"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes"
          }
        },
        "options": {
          "legend": {
            "calcs": [
              "mean",
              "max"
            ],
            "displayMode": "table",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        }
      },
      {
        "id": 19,
        "title": "Disk I/O",
        "type": "timeseries",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 12,
          "y": 16
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "rate(node_disk_read_bytes_total{device=~\"nvme0n1|sda|vda\",instance=\"host.docker.internal:9100\"}[1m])",
            "refId": "A",
            "legendFormat": "Read"
          },
          {
            "expr": "rate(node_disk_written_bytes_total{device=~\"nvme0n1|sda|vda\",instance=\"host.docker.internal:9100\"}[1m])",
            "refId": "B",
            "legendFormat": "Write"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "Bps"
          }
        },
        "options": {
          "legend": {
            "calcs": [
              "mean",
              "max"
            ],
            "displayMode": "table",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        }
      },
      {
        "id": 20,
        "title": "SSL Expiry (all sites)",
        "type": "timeseries",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 18,
          "y": 16
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "(probe_ssl_earliest_cert_expiry{instance=~\"$site\"} - time()) / 86400",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "d"
          }
        },
        "options": {
          "legend": {
            "calcs": [
              "mean",
              "max"
            ],
            "displayMode": "table",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "site",
          "type": "query",
          "query": "label_values(probe_success, instance)",
          "refresh": 1,
          "includeAll": true,
          "allValue": ".*",
